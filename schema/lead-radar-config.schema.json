{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Lead Radar Config",
  "type": "object",
  "properties": {
    "scoring": {
      "type": "object",
      "properties": {
        "time_zone": { "type": "string", "minLength": 1 },
        "window_days": { "type": "integer", "minimum": 1 },
        "half_life_days": { "type": "integer", "minimum": 1 },
        "min_signal_confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "promote_threshold": { "type": "number", "minimum": 0, "maximum": 100 }
      },
      "required": ["window_days", "half_life_days", "min_signal_confidence", "promote_threshold"],
      "additionalProperties": false
    },
    "sources": {
      "type": "object",
      "properties": {
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "enabled": { "type": "boolean" },
              "type": { "type": "string", "enum": ["rss", "sitemap", "html_list", "html"] },
              "name": { "type": "string", "minLength": 1 },
              "url": { "type": "string", "minLength": 1 },
              "tags": { "type": "array", "items": { "type": "string" } },
              "weight": { "type": "number", "minimum": 0 },
              "max_items": { "type": "integer", "minimum": 1 },
              "max_pages": { "type": "integer", "minimum": 1 },
              "page_param": { "type": "string", "minLength": 1 },
              "start_page": { "type": "integer", "minimum": 0 },
              "include_regex": { "type": "string" },
              "exclude_regex": { "type": "string" }
            },
            "required": ["id", "enabled", "type", "name", "url"],
            "additionalProperties": false
          }
        }
      },
      "required": ["sources"],
      "additionalProperties": false
    },
    "keyword_packs": {
      "type": "object",
      "properties": {
        "packs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "enabled": { "type": "boolean" },
              "name": { "type": "string", "minLength": 1 },
              "tags": { "type": "array", "items": { "type": "string" } },
              "keywords": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "keyword": { "type": "string", "minLength": 1 },
                    "weight": { "type": "number" }
                  },
                  "required": ["keyword", "weight"],
                  "additionalProperties": false
                }
              }
            },
            "required": ["id", "enabled", "name", "keywords"],
            "additionalProperties": false
          }
        }
      },
      "required": ["packs"],
      "additionalProperties": false
    }
  },
  "required": ["scoring", "sources", "keyword_packs"],
  "additionalProperties": false
}
